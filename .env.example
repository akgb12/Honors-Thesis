# Use fake for development and anthropic for real calls
MODEL_PROVIDER=fake
# Add the Anthropic API key locally
ANTHROPIC_API_KEY=
# Choose the generator model
GENERATOR_MODEL=claude-sonnet-5-5
# Set the input price in dollars per million tokens
MODEL_INPUT_USD_PER_MTOK=
# Set the output price in dollars per million tokens
MODEL_OUTPUT_USD_PER_MTOK=
# Limit output tokens for one model call
MODEL_MAX_OUTPUT_TOKENS=1000
# Store model responses in this local folder
MODEL_CACHE_DIR=.cache/model_responses

# Limit low effort run cost in dollars
RUN_DOLLAR_CAP_LOW=0.50
# Limit medium effort run cost in dollars
RUN_DOLLAR_CAP_MEDIUM=1.50
# Limit high effort run cost in dollars
RUN_DOLLAR_CAP_HIGH=3.00
# Set the preliminary accessibility score floor
FLOOR_A=60
# Set the preliminary fidelity score floor
FLOOR_F=90
# Require this share of figure concepts
CONCEPT_COVERAGE_THRESHOLD=0.75
# Limit repairs for one element
ELEMENT_REPAIR_LIMIT=2

# Store completed runs in this local folder
RUNS_DIR=runs
# Use pdfLaTeX for Mark 1
TEX_ENGINE=pdflatex
# Stop a compile after this many seconds
COMPILE_TIMEOUT_SECONDS=180
# Use this language when the source does not provide one
DEFAULT_LANG=en-US
# Add a veraPDF command path to enable its checks
VERAPDF_PATH=

# Add a Django secret locally
DJANGO_SECRET_KEY=
# Enable Django development messages
DJANGO_DEBUG=true
# Connect Django to this local database
DATABASE_URL=postgres://localhost:5432/honors_thesis
# Store backend files in this local folder
MEDIA_ROOT=storage
# Allow requests from this frontend address
CORS_ALLOWED_ORIGINS=http://localhost:5173
